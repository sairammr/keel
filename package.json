{
  "name": "keel",
  "private": true,
  "version": "0.1.0",
  "description": "Keel — verifiable-secrecy liquidation protection on Chainlink CRE",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "tune": "bun run packages/scenario/src/tune.ts",
    "replay": "bun run packages/scenario/src/replay.ts",
    "e2e": "bash tests/e2e/e2e.sh",
    "contracts:test": "cd contracts && forge test",
    "rpc-check": "bun run scripts/rpc-check.ts",
    "codehash": "bun run workflow/src/codehash.ts",
    "verify": "bun run packages/verifier/src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@chainlink/cre-sdk": "1.18.0",
    "@noble/hashes": "^2.4.0",
    "viem": "^2.17"
  }
}
